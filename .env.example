# Security & Server Settings
DEBUG=False
SECRET_KEY=your-production-secret-key-at-least-32-characters-long
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# File Upload Settings
MAX_UPLOAD_SIZE_BYTES=52428800

# Authentication & Access Control
# Set to True to require authentication for query and document operations
API_REQUIRE_AUTH=False
# Optional API key for header-based authentication (X-API-KEY or Bearer token)
API_SECRET_KEY=your-secure-api-key

# Rate Limiting (applied when public access is enabled or per-user)
RATELIMIT_ANON=60/minute
RATELIMIT_USER=120/minute
RATELIMIT_UPLOAD=20/minute
RATELIMIT_QUERY=30/minute

# Ollama Local LLM Configuration
OLLAMA_MODEL_NAME=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
SERPAPI_API_KEY=Your_SERPAPI_API_Key

# Local Embedding & Vector Store Settings (BGE-Small-EN-v1.5)
LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_COLLECTION_NAME=pdf_documents_bge_small_v1
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
BGE_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 